# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# All providers below have free tiers that need no payment card.
# Rule: never attach a card to any of these accounts. Rate limits must be
# hard stops, not charges.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (fallback, 50 req/day on free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Where Evolvra keeps its SQLite DB and trace log (default: ~/.evolvra)
# EVOLVRA_HOME=

# Conservative daily request caps (kept BELOW published free limits)
# EVOLVRA_CAP_GEMINI=1000
# EVOLVRA_CAP_GROQ=800
# EVOLVRA_CAP_OPENROUTER=40

# Model ids (defaults are best-known as of Nov 2026; catalogs change).
# Run `evolvra models gemini` / `evolvra models groq` to see what your key can use.
# EVOLVRA_MODEL_GEMINI=gemini-3.8-flash
# EVOLVRA_MODEL_GROQ=openai/gpt-oss-120b
# EVOLVRA_MODEL_OPENROUTER=openai/gpt-oss-120b:free
